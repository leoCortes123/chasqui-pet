          "name": "Chasqui Pet Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- A las 3 de la mañana no hay nadie usando el sistema: es el momento de\n-- que Postgres recalcule las estadísticas de las tablas que más se\n-- mueven. Sin esto, la búsqueda por trigramas del catálogo se degrada\n-- según crece el histórico de movimientos.\nANALYZE movimiento_inventario, turno, cuenta, evento_auditoria;\nSELECT 1 AS ok;",
        "options": {}
      },
      "id": "sql-analyze",
      "name": "Recalcular estadísticas",
